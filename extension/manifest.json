{
  "manifest_version": 3,
  "name": "Universal Web Scraper",
  "version": "1.0.0",
  "description": "Point-and-click web scraper with AI auto-detection, scroll & pagination, CSV/JSON/Excel export, and template reuse. Works on any website.",

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Universal Web Scraper"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/highlighter.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "options_page": "options/options.html",

  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.mini.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
